{
  "name": "penguins-helper",
  "version": "0.1.0",
  "description": "A penguin that sits at the bottom of your screen and holds your clipboard.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test.js",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.18.0"
  },
  "license": "MIT",
  "repository": "github:NotWutLit/penguins-helper",
  "productName": "Penguin's Helper",
  "author": "NotWutLit",
  "build": {
    "appId": "io.github.notwutlit.penguinshelper",
    "productName": "Penguin's Helper",
    "files": [
      "main.js",
      "preload.js",
      "history.js",
      "index.html",
      "package.json",
      "build/icon.ico"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Penguins-Helper-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Penguins-Helper-${version}-portable.exe"
    }
  }
}
